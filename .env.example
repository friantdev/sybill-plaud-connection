# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/plaud-sybill-db

# Webhook Security (Zapier -> Integration)
# Webhook secret shared with Zapier webhook action
WEBHOOK_SECRET=your_plaud_zapier_webhook_secret_here
# Max clock drift in seconds allowed for timestamp verification
WEBHOOK_MAX_AGE_SECONDS=300

# Admin Authentication (API Key for Admin/Operator endpoints)
ADMIN_API_KEY=your_admin_api_key_secret_here

# Sybill Outbound API
SYBILL_API_BASE_URL=https://api.sybill.ai/v1
SYBILL_API_KEY=your_sybill_api_key_here
SYBILL_IMPORT_ENDPOINT=/conversations/import
# Timeout for Sybill request in milliseconds
SYBILL_REQUEST_TIMEOUT_MS=15000

# Retry Policies
MAX_DELIVERY_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=2000
RETRY_MAX_DELAY_MS=60000
RETRY_BACKOFF_FACTOR=2
RETRY_JITTER_RATIO=0.2

# Proof of Concept Mode: if true, only process users explicitly marked as in proof of concept
POC_MODE_ENABLED=false
